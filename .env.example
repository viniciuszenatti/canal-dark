# Canal Dark — Variáveis de Ambiente (modelo: Shorts narrados)
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o .env com valores reais (está no .gitignore).
#
# Carregamento:
#   Python  : pip install python-dotenv → from dotenv import load_dotenv; load_dotenv()
#   n8n     : Settings > Environment Variables no painel do n8n
#   Docker  : --env-file .env no docker run, ou env_file: no compose

# ── Google / Gemini ───────────────────────────────────────────────────────────

# Chave da Google AI Studio para o modelo Gemini (geração de roteiro + guardrail)
# Obtenha em: https://aistudio.google.com/app/apikey
# Limites grátis (maio 2026): gemini-2.5-flash-lite: 1.500 req/dia, 15 req/min
GEMINI_API_KEY=AIza...

# ── Pexels (b-roll de fundo) ──────────────────────────────────────────────────

# Chave da API do Pexels para download de b-roll gratuito
# Obtenha em: https://www.pexels.com/api/ (aprovação imediata, uso comercial free)
# Limites grátis: 200 req/hora, 20.000 req/mês
PEXELS_API_KEY=...

# ── ElevenLabs TTS (opcional) ─────────────────────────────────────────────────

# Chave da API ElevenLabs para voz de alta qualidade (alternativa ao edge-tts grátis)
# Obtenha em: https://elevenlabs.io/app/settings/api-keys
# Plano grátis: 10.000 caracteres/mês. Para uso diário, considere plano pago.
# Deixe vazio para usar edge-tts (padrão, sem necessidade de chave).
ELEVENLABS_API_KEY=

# ── Telegram (alertas e checkpoints humanos) ──────────────────────────────────

# Token do bot criado via @BotFather no Telegram
# Crie um bot: abra @BotFather > /newbot > siga as instruções
TELEGRAM_BOT_TOKEN=123456789:AAF...

# ID do chat onde os alertas e roteiros serão enviados para revisão
# Para descobrir o seu: envie mensagem ao bot e acesse:
# https://api.telegram.org/bot<TOKEN>/getUpdates — o campo "chat.id" está na resposta
TELEGRAM_CHAT_ID=123456789

# ── Postiz (publicação multi-plataforma) ──────────────────────────────────────

# URL base da sua instância Postiz (sem barra final)
# Docker local: http://localhost:3000
POSTIZ_URL=http://localhost:3000

# Chave de API do Postiz
# Gere em: painel do Postiz > Settings > API Keys
POSTIZ_API_KEY=pk_...

# ── Google Sheets (log de shorts publicados) ──────────────────────────────────

# ID da planilha Google Sheets para log
# Extraia da URL: https://docs.google.com/spreadsheets/d/ESTE_ID/edit
GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# ── Canal Dark — Caminhos (usados pelo n8n via Code Node) ─────────────────────

# Caminho absoluto para o short_factory.py dentro do container do n8n
# Windows dev: C:/Users/aless/canal-dark/short_factory.py
# Docker      : /app/canal-dark/short_factory.py
CANAL_DARK_PATH=/app/canal-dark/short_factory.py

# Diretório de saída dos shorts gerados (compartilhado entre n8n e Postiz)
CANAL_DARK_OUTPUT_DIR=/app/canal-dark/out

# Voz do TTS edge-tts (padrão, sem chave necessária)
# Lista completa: python -m edge_tts --list-voices
# Opções populares: en-US-AriaNeural (feminino), en-US-GuyNeural (masculino),
#                   en-GB-SoniaNeural (britânico feminino), en-AU-NatashaNeural
TTS_VOICE=en-US-AriaNeural

# ── image_providers (b-roll grátis sem chave paga) ───────────────────────────

# Lista CSV de providers a tentar (em ordem de preferência).
# Disponíveis: wikimedia, openverse, internetarchive, aihorde, pollinations, fandom, civitai
# Exemplo: IMG_PROVIDERS=wikimedia,openverse
IMG_PROVIDERS=

# Override por lane (sobrepõe IMG_PROVIDERS para aquela lane específica):
IMG_PROVIDERS_BURN=
IMG_PROVIDERS_GENERATE=aihorde,pollinations
IMG_PROVIDERS_ANIME=fandom,civitai
IMG_PROVIDERS_REF=wikimedia,internetarchive

# Lane de copyright default para o b-roll.
# burn     = só PD/CC0/CC-BY/CC-BY-SA (seguro para publicar)
# generate = imagens geradas por IA (sem restrição de copyright)
# anime    = franquias (IP protegida; exige ALLOW_ANIME=1 + revisão humana)
# ref      = baixa para out/img_ref/ mas NÃO usa no vídeo
IMG_LANE=burn

# Habilita lane anime (IP protegida; exige revisão humana antes de publicar)
ALLOW_ANIME=0

# Pasta de cache de imagens (default: <cwd>/out/img_cache)
IMG_CACHE_DIR=

# Licenças aceitas pelo Openverse (default: cc0,pdm)
OPENVERSE_LICENSES=cc0,pdm

# Chave da AI Horde para geração de imagens (0000000000 = fila pública grátis)
AIHORDE_API_KEY=0000000000

# Timeout HTTP para downloads de imagem em segundos (default: 30; geradores usam 120)
IMG_HTTP_TIMEOUT=30

# ── n8n (configuração do container) ──────────────────────────────────────────

# Fuso horário para o Schedule Trigger
N8N_DEFAULT_TIMEZONE=America/Sao_Paulo

# URL base do n8n (para referência e webhooks futuros)
N8N_BASE_URL=http://localhost:5678

# Credenciais básicas do n8n (mude antes de expor à internet)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=mude-esta-senha-agora
